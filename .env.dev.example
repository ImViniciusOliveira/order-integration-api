# ==============================================================================
# AMBIENTE DE DESENVOLVIMENTO (DEV) - TEMPLATE DE EXEMPLO
# Copie este arquivo para .env.dev e preencha com seus dados locais.
# ==============================================================================

# --- Spring Boot Profile & Server ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Autenticação e Segurança Interna ---
INTERNAL_API_KEY=dev-internal-key-12345

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Banco de Dados Relacional (PostgreSQL) ---
POSTGRES_DB=order_integration_db
POSTGRES_USER=order_db_user
POSTGRES_PASSWORD=order_db_pass

# --- Cache & Fila de Atraso (Redis) ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
ESCROW_REDIS_QUEUE_KEY=dcriar:orders:escrow_delay_queue
ESCROW_DELAY_MINUTES=120
ESCROW_RETRY_DELAY_MINUTES=30
ESCROW_WORKER_INTERVAL_MS=60000
ESCROW_BATCH_SIZE=50
ESCROW_MAX_RETRIES=5

# --- Banco de Dados NoSQL (MongoDB - Se aplicável) ---
MONGO_USER=order_mongo_user
MONGO_PASSWORD=order_mongo_pass
MONGO_DB=order_integration_mongo

# --- APIs de Marketplace ---
SHOPEE_API_BASE_URL=https://partner.shopeemobile.com
SHOPEE_ESCROW_PATH=/api/v2/payment/get_escrow_detail
MERCADO_LIVRE_API_BASE_URL=https://api.mercadolibre.com
MERCADO_LIVRE_ORDERS_PATH=/orders
MERCADO_LIVRE_SHIPMENTS_PATH=/shipments
MERCADO_LIVRE_PAYMENTS_PATH=/v1/payments
MERCADO_LIVRE_OAUTH_TOKEN_PATH=/oauth/token

# --- Webhooks & Automação (n8n + ngrok) ---
N8N_WEBHOOK_URL=https://seu-dominio-ngrok.ngrok-free.app
NGROK_AUTHTOKEN=seu_ngrok_authtoken_aqui
NGROK_DOMAIN=seu-dominio-ngrok.ngrok-free.app
