# ==============================================================================
# TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE (DEVELOPMENT)
# ==============================================================================
# Copie este arquivo para .env.dev e preencha com seus dados locais.
# Este arquivo serve de modelo e não contém senhas reais.
# ==============================================================================

# Spring Boot API
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=order_integration_db

# MongoDB (Armazenamento de tokens e credenciais do n8n)
MONGO_USER=order_mongo_user
MONGO_PASSWORD=order_mongo_pass
MONGO_DB=order_integration_mongodb

# Redis (Orquestração de filas com delay para conciliação / escrow)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# n8n & Ngrok
N8N_WEBHOOK_URL=https://seu-dominio.ngrok-free.dev
NGROK_AUTHTOKEN=seu_ngrok_authtoken
NGROK_DOMAIN=seu-dominio.ngrok-free.dev

# Segurança M2M (n8n -> Spring Boot API)
INTEGRATION_API_KEY=sua_chave_secreta_integracao
