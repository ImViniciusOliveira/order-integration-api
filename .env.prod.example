# ==============================================================================
# AMBIENTE DE PRODUÇÃO (PROD) - TEMPLATE DE EXEMPLO
# Copie este arquivo para .env.prod no servidor de produção.
# NUNCA comite senhas reais no controle de versão!
# ==============================================================================

# --- Spring Boot Profile & Server ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Banco de Dados Relacional (PostgreSQL) ---
POSTGRES_DB=order_integration_db_prod
POSTGRES_USER=order_db_user_prod
POSTGRES_PASSWORD=senha_ultra_segura_postgres_prod

# --- Cache & Fila de Atraso (Redis) ---
SPRING_DATA_REDIS_HOST=redis-order
SPRING_DATA_REDIS_PORT=6379
ESCROW_REDIS_QUEUE_KEY=dcriar:orders:escrow_delay_queue
ESCROW_DELAY_MINUTES=120

# --- Banco de Dados NoSQL (MongoDB) ---
MONGO_USER=order_mongo_user_prod
MONGO_PASSWORD=senha_ultra_segura_mongo_prod
MONGO_DB=order_integration_mongo_prod

# --- Webhooks & Automação (n8n) ---
N8N_WEBHOOK_URL=https://n8n.seudominio.com.br
