# ==============================================================================
# AMBIENTE DE PRODUÇÃO (PROD) - TEMPLATE DE EXEMPLO
# Copie este arquivo para .env.prod e configure com as credenciais seguras do servidor.
# ==============================================================================

# --- Spring Boot Profile & Server ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Banco de Dados Relacional (PostgreSQL) ---
POSTGRES_DB=order_integration_prod_db
POSTGRES_USER=order_prod_user
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui

# --- Cache & Fila de Atraso (Redis) ---
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
ESCROW_REDIS_QUEUE_KEY=dcriar:orders:escrow_delay_queue
ESCROW_DELAY_MINUTES=120
ESCROW_RETRY_DELAY_MINUTES=30
ESCROW_WORKER_INTERVAL_MS=60000
ESCROW_BATCH_SIZE=50
ESCROW_MAX_RETRIES=5

# --- Banco de Dados NoSQL (MongoDB - Se aplicável) ---
MONGO_USER=order_prod_mongo_user
MONGO_PASSWORD=defina_uma_senha_mongo_forte_aqui
MONGO_DB=order_integration_prod_mongo

# --- Webhooks & Automação (n8n) ---
N8N_WEBHOOK_URL=https://n8n.seudominio.com.br
