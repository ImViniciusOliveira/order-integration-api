# ==============================================================================
# AMBIENTE DE PRODUÇÃO (PROD) - TEMPLATE
# Copie para .env.prod e substitua todos os valores de exemplo.
# Nunca versione o arquivo .env.prod.
# ==============================================================================

# --- Imagem da API ---
DOCKERHUB_USERNAME=seu_usuario_dockerhub
API_IMAGE_TAG=0.0.1

# --- Spring Boot Profile & Server ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Autenticação e Segurança Interna ---
INTERNAL_API_KEY=gere_uma_chave_interna_forte
N8N_ENCRYPTION_KEY=gere_uma_chave_de_criptografia_forte_para_o_n8n

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ALLOWED_ORIGINS=https://painel.exemplo.invalid

# --- Banco de Dados Relacional (PostgreSQL) ---
POSTGRES_DB=order_integration_prod_db
POSTGRES_USER=order_prod_user
POSTGRES_PASSWORD=gere_uma_senha_forte

# --- Redis externo (Upstash) ---
SPRING_DATA_REDIS_HOST=redis-exemplo.upstash.io
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=senha_upstash
SPRING_DATA_REDIS_SSL_ENABLED=true
UPSTASH_REDIS_URL=rediss://default:senha_upstash@redis-exemplo.upstash.io:6379
ESCROW_REDIS_QUEUE_KEY=dcriar:orders:escrow_delay_queue
ESCROW_DELAY_MINUTES=120
ESCROW_RETRY_DELAY_MINUTES=30
ESCROW_WORKER_INTERVAL_MS=60000
ESCROW_BATCH_SIZE=50
ESCROW_MAX_RETRIES=5

# --- MongoDB externo (Atlas) ---
MONGODB_URI=mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net/order_integration_prod?retryWrites=true&w=majority

# --- APIs de Marketplace ---
SHOPEE_API_BASE_URL=https://partner.shopeemobile.com
SHOPEE_ESCROW_PATH=/api/v2/payment/get_escrow_detail
MERCADO_LIVRE_API_BASE_URL=https://api.mercadolibre.com
MERCADO_LIVRE_ORDERS_PATH=/orders
MERCADO_LIVRE_SHIPMENTS_PATH=/shipments
MERCADO_LIVRE_PAYMENTS_PATH=/v1/payments
MERCADO_LIVRE_OAUTH_TOKEN_PATH=/oauth/token

# --- Webhooks e ngrok ---
NGROK_AUTHTOKEN=token_ngrok
NGROK_DOMAIN=seu-endereco-ngrok
N8N_WEBHOOK_URL=https://seu-endereco-ngrok
